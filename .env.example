# ZEBDECOR SPATIAL COMMERCE — ENVIRONMENT CONFIGURATION
# Leave WORDPRESS_API_URL blank to run with the Zero-Downtime Resilient Typed Snapshot,
# or point to your Headless WordPress + WooCommerce origin (e.g. http://localhost:8080)
WORDPRESS_API_URL=
NEXT_PUBLIC_WORDPRESS_API_URL=

# Shared HMAC-SHA256 secret between WordPress (`cms/wordpress/zebdecor-headless-bridge.php`)
# and Next.js (`POST /api/webhooks/wordpress`)
WORDPRESS_WEBHOOK_SECRET=zebdecor-wp-vip-hmac-secret-2026
